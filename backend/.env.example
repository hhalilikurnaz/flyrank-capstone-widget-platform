NODE_ENV=development
PORT=4000

# Postgres (matches docker-compose.yml service "postgres")
DATABASE_URL=postgresql://widget_platform:widget_platform@localhost:5432/widget_platform

# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=7d

# CORS allow-list for the authenticated dashboard API (submission/config/widget.js stay public *)
FRONTEND_URL=http://localhost:5173

# Mailpit (docker-compose.yml service "mailpit") — local SMTP catcher, no real credentials needed
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@widget-platform.local
