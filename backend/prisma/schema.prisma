generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WidgetType {
  SIGNUP
  CTA
  POPOVER
}

enum Device {
  DESKTOP
  TABLET
  MOBILE
}

model Tenant {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  createdAt           DateTime  @default(now())
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  widgets     Widget[]
  submissions Submission[]
  impressions Impression[]
}

model Widget {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           WidgetType
  title          String
  description    String?
  fields         Json       @default("[]")
  buttonText     String     @default("Submit")
  displayOptions Json       @default("{}")
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  submissions Submission[]
  impressions Impression[]

  @@index([tenantId])
}

// One row per widget config fetch — i.e. once per real page load where the
// widget SDK mounts. Powers impressions/conversion-rate/device-breakdown.
model Impression {
  id        String   @id @default(uuid())
  widgetId  String
  widget    Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    Device
  createdAt DateTime @default(now())

  @@index([widgetId, createdAt])
  @@index([tenantId, createdAt])
}

model Submission {
  id        String   @id @default(uuid())
  widgetId  String
  widget    Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data      Json
  ip        String
  country   String?
  city      String?
  isSpam    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([widgetId, createdAt])
  @@index([tenantId, createdAt])
}
