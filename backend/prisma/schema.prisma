generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WidgetType {
  SIGNUP
  CTA
  POPOVER
}

enum Device {
  DESKTOP
  TABLET
  MOBILE
}

model Tenant {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  createdAt           DateTime  @default(now())
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  widgets     Widget[]
  submissions Submission[]
  impressions Impression[]
  apiKeys     ApiKey[]
  webhooks    Webhook[]
  webhookLogs WebhookLog[]
  auditLogs   AuditLog[]
}

model ApiKey {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String   @unique
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model Webhook {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url        String
  events     String[] @default(["submission.created"])
  isActive   Boolean  @default(true)
  secret     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  logs WebhookLog[]

  @@index([tenantId])
}

model WebhookLog {
  id        String   @id @default(uuid())
  webhookId String
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event     String
  payload   Json
  status    Int?
  response  String?
  error     String?
  attempts  Int      @default(1)
  nextRetry DateTime?
  createdAt DateTime @default(now())

  @@index([webhookId])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Widget {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           WidgetType
  title          String
  description    String?
  fields         Json       @default("[]")
  buttonText     String     @default("Submit")
  displayOptions Json       @default("{}")
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  submissions Submission[]
  impressions Impression[]

  @@index([tenantId])
}

// One row per widget config fetch — i.e. once per real page load where the
// widget SDK mounts. Powers impressions/conversion-rate/device-breakdown.
model Impression {
  id        String   @id @default(uuid())
  widgetId  String
  widget    Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    Device
  createdAt DateTime @default(now())

  @@index([widgetId, createdAt])
  @@index([tenantId, createdAt])
}

model Submission {
  id        String   @id @default(uuid())
  widgetId  String
  widget    Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data      Json
  ip        String
  country   String?
  city      String?
  isSpam    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([widgetId, createdAt])
  @@index([tenantId, createdAt])
}
